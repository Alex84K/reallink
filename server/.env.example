# ── server ──────────────────────────────────────────────
PORT=8080
LOG_LEVEL=info            # debug | info | warn | error
LOG_FORMAT=text           # text (dev) | json (prod)

# ── database ────────────────────────────────────────────
DB_PATH=./data/reallink.db

# ── links ───────────────────────────────────────────────
# Базовый URL для персональных ссылок участников в текстах уведомлений
APP_BASE_URL=http://localhost:5173

# ── sessions (Go duration) ──────────────────────────────
PARTICIPANT_SESSION_TTL=2160h   # 90 дней
ADMIN_SESSION_TTL=168h          # 7 дней

# ── rate limit ──────────────────────────────────────────
PUBLIC_RATE_LIMIT_PER_MINUTE=10   # анкета, обмен ссылки
ADMIN_LOGIN_MAX_FAILURES=5
ADMIN_LOGIN_LOCKOUT=15m
